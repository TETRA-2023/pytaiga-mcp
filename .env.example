# Taiga MCP Server Configuration
# Copy this file to .env and fill in your values

# Taiga base URL: scheme, host and any path prefix, e.g. https://taiga.example.com.
# The server adds /api/v1 (a trailing /api/v1 is stripped). Use the final https:// URL.
TAIGA_API_URL=http://localhost:9000

# Credentials for auto-authentication on server startup.
# When set, the server logs in and creates a "default" session, so credentials
# never have to pass through the AI conversation.
TAIGA_USERNAME=your_username
TAIGA_PASSWORD=your_password

# Closing-receipt guard (default true): false lets stories/tasks close without a receipt comment
# TAIGA_CLOSING_RECEIPTS=true

# Transport: stdio (default), sse, or streamable-http
TAIGA_TRANSPORT=stdio
# Bind address and port for the HTTP transports (use 0.0.0.0 in Docker)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
